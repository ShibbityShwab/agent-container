# =============================================
# OpenCode + Oh-My-OpenAgent Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit the real .env file
# =============================================

# === Free / Cheap Cloud Providers (Recommended) ===

# Google Gemini (free tier - get from aistudio.google.com)
GOOGLE_API_KEY=AIzaSy...

# Groq (very fast free tier - console.groq.com)
GROQ_API_KEY=gsk_...

# OpenRouter (unified access to many cheap models - openrouter.ai)
OPENROUTER_API_KEY=sk-or-...

# === Best Value Flat-Rate Upgrade ===
# OpenCode Go ($5 first month, then $10/mo) - opencode.ai/go or /connect in TUI
OPENCODE_GO_API_KEY=...

# === Optional Paid / Other ===
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# You can add more provider keys as needed.
# OpenCode and Oh-My-OpenAgent will pick them up automatically.
