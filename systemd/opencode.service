[Unit]
Description=OpenCode + Oh-My-OpenAgent (Lean Grind Setup)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# WARNING: This path must match the directory name you cloned the repo into.
# If you used a different name, update both WorkingDirectory and EnvironmentFile below.
WorkingDirectory=%h/my-ai-grind-project
EnvironmentFile=%h/my-ai-grind-project/.env
ExecStart=%h/.bun/bin/opencode serve --port 4096 --hostname 0.0.0.0
Restart=on-failure
RestartSec=10

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=default.target
